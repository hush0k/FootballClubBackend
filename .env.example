APP_NAME=FootballClubBackend
DEBUG=true

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=football_club

# Порт Postgres из docker-compose на хосте (5432 занят локальным Postgres)
DB_PORT_EXTERNAL=5433

CORS_ORIGINS=http://localhost:5173

# Секрет для подписи JWT: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440
